<mujoco model="turtlebot3_waffle_pi">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.005" integrator="RK4"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3"/>
  </default>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.15 0.2" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.25 0.35 0.45" rgb2="0.15 0.2 0.25"/>
    <material name="grid_mat" texture="grid" texrepeat="25 25" reflectance="0.2"/>
    <material name="dark_gray" rgba="0.2 0.2 0.2 1"/>
    <material name="light_gray" rgba="0.75 0.75 0.75 1"/>
    <material name="black" rgba="0.08 0.08 0.08 1"/>
    <material name="red_axis" rgba="1 0 0 1"/>
    <material name="green_axis" rgba="0 1 0 1"/>
    <material name="blue_axis" rgba="0 0 1 1"/>
    <material name="orange" rgba="0.95 0.45 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Ground Plane -->
    <geom name="floor" type="plane" size="20 20 0.1" material="grid_mat" friction="1.5 0.01 0.001"/>

    <!-- Fixed World Reference Frame {s} at Origin -->
    <site name="world_origin" pos="0 0 0.005" size="0.02" rgba="1 1 0 0.5"/>
    <geom name="world_x" type="cylinder" fromto="0 0 0.005 0.4 0 0.005" size="0.006" rgba="1 0 0 0.35" contype="0" conaffinity="0"/>
    <geom name="world_y" type="cylinder" fromto="0 0 0.005 0 0.4 0.005" size="0.006" rgba="0 1 0 0.35" contype="0" conaffinity="0"/>
    <geom name="world_z" type="cylinder" fromto="0 0 0.005 0 0 0.405" size="0.006" rgba="0 0 1 0.35" contype="0" conaffinity="0"/>

    <!-- TurtleBot3 Body -->
    <body name="turtlebot" pos="0 0 0.08">
      <freejoint name="root"/>
      
      <!-- Main Chassis Plates -->
      <geom name="base_plate_bottom" type="box" size="0.13 0.13 0.004" pos="-0.03 0 0.01" material="dark_gray" mass="0.6"/>
      <geom name="base_plate_top" type="box" size="0.13 0.13 0.004" pos="-0.03 0 0.07" material="dark_gray" mass="0.4"/>
      
      <!-- Standoff Spacers -->
      <geom name="sp_fl" type="cylinder" fromto="0.08 0.10 0.014 0.08 0.10 0.066" size="0.004" material="light_gray" mass="0.01" contype="0" conaffinity="0"/>
      <geom name="sp_fr" type="cylinder" fromto="0.08 -0.10 0.014 0.08 -0.10 0.066" size="0.004" material="light_gray" mass="0.01" contype="0" conaffinity="0"/>
      <geom name="sp_bl" type="cylinder" fromto="-0.13 0.10 0.014 -0.13 0.10 0.066" size="0.004" material="light_gray" mass="0.01" contype="0" conaffinity="0"/>
      <geom name="sp_br" type="cylinder" fromto="-0.13 -0.10 0.014 -0.13 -0.10 0.066" size="0.004" material="light_gray" mass="0.01" contype="0" conaffinity="0"/>

      <!-- Battery & Board -->
      <geom name="battery" type="box" size="0.04 0.05 0.012" pos="-0.04 0 0.025" material="black" mass="0.3"/>
      <geom name="sbc" type="box" size="0.04 0.03 0.004" pos="-0.03 0 0.076" rgba="0.1 0.6 0.2 1" mass="0.1"/>

      <!-- LDS Lidar -->
      <geom name="lidar_base" type="cylinder" pos="-0.064 0 0.088" size="0.032 0.012" material="black" mass="0.12" contype="0" conaffinity="0"/>
      <geom name="lidar_top" type="cylinder" pos="-0.064 0 0.106" size="0.028 0.008" material="orange" mass="0.05" contype="0" conaffinity="0"/>

      <!-- Camera Mount -->
      <geom name="cam_mount" type="box" pos="0.095 0 0.085" size="0.008 0.02 0.015" material="dark_gray" mass="0.02" contype="0" conaffinity="0"/>
      <geom name="cam_lens" type="cylinder" fromto="0.10 0 0.085 0.11 0 0.085" size="0.006" material="black" mass="0.01" contype="0" conaffinity="0"/>

      <!-- Attached Moving Body Frame {b} (RGB = XYZ) -->
      <site name="body_origin" pos="0 0 0.08" size="0.012" rgba="1 1 0 1"/>
      <geom name="body_x_axis" type="cylinder" fromto="0 0 0.08 0.20 0 0.08" size="0.005" material="red_axis" mass="0.001" contype="0" conaffinity="0"/>
      <geom name="body_y_axis" type="cylinder" fromto="0 0 0.08 0 0.20 0.08" size="0.005" material="green_axis" mass="0.001" contype="0" conaffinity="0"/>
      <geom name="body_z_axis" type="cylinder" fromto="0 0 0.08 0 0 0.22" size="0.005" material="blue_axis" mass="0.001" contype="0" conaffinity="0"/>

      <!-- Left Wheel -->
      <body name="left_wheel" pos="0 0.144 -0.047">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.033 0.009" zaxis="0 1 0" material="black" mass="0.1" friction="2.0 0.01 0.001"/>
        <geom name="left_cap" type="cylinder" size="0.016 0.010" zaxis="0 1 0" material="orange" mass="0.01" contype="0" conaffinity="0"/>
      </body>

      <!-- Right Wheel -->
      <body name="right_wheel" pos="0 -0.144 -0.047">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.033 0.009" zaxis="0 1 0" material="black" mass="0.1" friction="2.0 0.01 0.001"/>
        <geom name="right_cap" type="cylinder" size="0.016 0.010" zaxis="0 1 0" material="orange" mass="0.01" contype="0" conaffinity="0"/>
      </body>

      <!-- Front Low-Friction Caster Support -->
      <body name="front_caster" pos="0.09 0 -0.065">
        <geom name="front_caster_geom" type="sphere" size="0.015" material="light_gray" mass="0.02" friction="0.0001 0.0001 0.0001"/>
      </body>

      <!-- Rear Low-Friction Caster Support -->
      <body name="rear_caster" pos="-0.13 0 -0.065">
        <geom name="rear_caster_geom" type="sphere" size="0.015" material="light_gray" mass="0.02" friction="0.0001 0.0001 0.0001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_motor" joint="left_wheel_joint" kv="100" forcerange="-5 5"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="100" forcerange="-5 5"/>
  </actuator>
</mujoco>
