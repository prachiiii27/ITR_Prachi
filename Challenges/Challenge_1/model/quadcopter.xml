<mujoco model="quadcopter_drone">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.005" integrator="RK4"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.15 0.2" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.2"/>
    <material name="carbon_fiber" rgba="0.15 0.15 0.15 1"/>
    <material name="prop_cw" rgba="0.9 0.2 0.2 0.8"/>
    <material name="prop_ccw" rgba="0.2 0.4 0.9 0.8"/>
    <material name="red_axis" rgba="1 0 0 1"/>
    <material name="green_axis" rgba="0 1 0 1"/>
    <material name="blue_axis" rgba="0 0 1 1"/>
    <material name="gold" rgba="0.9 0.7 0.2 1"/>
  </asset>

  <worldbody>
    <!-- Ground Plane & Helipad -->
    <geom name="floor" type="plane" size="20 20 0.1" material="grid_mat"/>
    <site name="helipad_center" pos="0 0 0.002" size="0.6" type="cylinder" rgba="0.9 0.7 0.2 0.6"/>
    <site name="helipad_ring" pos="0 0 0.003" size="0.8 0.001" type="cylinder" rgba="1 1 1 0.4"/>

    <!-- Fixed World Frame Reference at Origin -->
    <geom name="world_x" type="cylinder" fromto="0 0 0.005 0.6 0 0.005" size="0.01" rgba="1 0 0 0.4"/>
    <geom name="world_y" type="cylinder" fromto="0 0 0.005 0 0.6 0.005" size="0.01" rgba="0 1 0 0.4"/>
    <geom name="world_z" type="cylinder" fromto="0 0 0.005 0 0 0.605" size="0.01" rgba="0 0 1 0.4"/>

    <!-- 6-DOF Quadcopter Drone -->
    <body name="quadcopter" pos="0 0 1.0">
      <freejoint name="drone_root"/>

      <!-- Central Fuselage / Avionics Pod -->
      <geom name="fuselage" type="box" size="0.07 0.07 0.025" material="carbon_fiber" mass="0.6"/>
      <geom name="battery" type="box" size="0.05 0.04 0.015" pos="0 0 -0.03" rgba="0.2 0.2 0.2 1" mass="0.4"/>
      <geom name="flight_controller" type="box" size="0.02 0.02 0.005" pos="0 0 0.03" material="gold" mass="0.05"/>

      <!-- Carbon Fiber Diagonal Arms (X-Configuration, arm length = 0.25m) -->
      <!-- Arm 1: Front-Right (+X, -Y) -->
      <geom name="arm_fr" type="cylinder" fromto="0 0 0 0.18 -0.18 0" size="0.008" material="carbon_fiber" mass="0.05"/>
      <geom name="motor_fr" type="cylinder" pos="0.18 -0.18 0.015" size="0.018 0.012" material="gold" mass="0.06"/>
      <geom name="prop_fr" type="cylinder" pos="0.18 -0.18 0.03" size="0.11 0.003" material="prop_cw" mass="0.01"/>

      <!-- Arm 2: Front-Left (+X, +Y) -->
      <geom name="arm_fl" type="cylinder" fromto="0 0 0 0.18 0.18 0" size="0.008" material="carbon_fiber" mass="0.05"/>
      <geom name="motor_fl" type="cylinder" pos="0.18 0.18 0.015" size="0.018 0.012" material="gold" mass="0.06"/>
      <geom name="prop_fl" type="cylinder" pos="0.18 0.18 0.03" size="0.11 0.003" material="prop_ccw" mass="0.01"/>

      <!-- Arm 3: Rear-Left (-X, +Y) -->
      <geom name="arm_rl" type="cylinder" fromto="0 0 0 -0.18 0.18 0" size="0.008" material="carbon_fiber" mass="0.05"/>
      <geom name="motor_rl" type="cylinder" pos="-0.18 0.18 0.015" size="0.018 0.012" material="gold" mass="0.06"/>
      <geom name="prop_rl" type="cylinder" pos="-0.18 0.18 0.03" size="0.11 0.003" material="prop_cw" mass="0.01"/>

      <!-- Arm 4: Rear-Right (-X, -Y) -->
      <geom name="arm_rr" type="cylinder" fromto="0 0 0 -0.18 -0.18 0" size="0.008" material="carbon_fiber" mass="0.05"/>
      <geom name="motor_rr" type="cylinder" pos="-0.18 -0.18 0.015" size="0.018 0.012" material="gold" mass="0.06"/>
      <geom name="prop_rr" type="cylinder" pos="-0.18 -0.18 0.03" size="0.11 0.003" material="prop_ccw" mass="0.01"/>

      <!-- Landing Legs -->
      <geom name="leg_fr" type="cylinder" fromto="0.12 -0.12 -0.01 0.15 -0.15 -0.08" size="0.005" material="carbon_fiber" mass="0.01"/>
      <geom name="leg_fl" type="cylinder" fromto="0.12 0.12 -0.01 0.15 0.15 -0.08" size="0.005" material="carbon_fiber" mass="0.01"/>
      <geom name="leg_rl" type="cylinder" fromto="-0.12 0.12 -0.01 -0.15 0.15 -0.08" size="0.005" material="carbon_fiber" mass="0.01"/>
      <geom name="leg_rr" type="cylinder" fromto="-0.12 -0.12 -0.01 -0.15 -0.15 -0.08" size="0.005" material="carbon_fiber" mass="0.01"/>

      <!-- Attached Body Coordinate Frame Axes (RGB = XYZ) -->
      <site name="drone_body_origin" pos="0 0 0.05" size="0.02" rgba="1 1 0 1"/>
      <geom name="body_x_axis" type="cylinder" fromto="0 0 0.05 0.35 0 0.05" size="0.008" material="red_axis" mass="0.001"/>
      <geom name="body_y_axis" type="cylinder" fromto="0 0 0.05 0 0.35 0.05" size="0.008" material="green_axis" mass="0.001"/>
      <geom name="body_z_axis" type="cylinder" fromto="0 0 0.05 0 0 0.40" size="0.008" material="blue_axis" mass="0.001"/>
    </body>
  </worldbody>
</mujoco>
